{
  "name": "kiliride",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "lint": "eslint",
    "local:env": "node scripts/local-env.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/run.mjs migrate",
    "db:migrate:test": "node scripts/run.mjs migrate-test",
    "typecheck": "tsc --noEmit --incremental false",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "node scripts/run.mjs test",
    "test": "npm run test:unit && npm run test:fleet && npm run test:integration",
    "admin:provision": "node --conditions=react-server --import tsx scripts/provision-admin.ts",
    "fleet:import": "node --conditions=react-server --import tsx scripts/import-legacy-fleet.ts",
    "test:fleet": "node scripts/run.mjs test-fleet"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "18.0.9",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  }
}
